<Project>
  <!-- Shared settings for every .NET project in the repo (services, libs, tests). -->
  <PropertyGroup>
    <!-- Runtime for all services. Changing this one line moves every service (e.g. to net10.0). -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Still shown as warnings, but they don't fail the build:
         NU1901-NU1904 = known vulnerability in a package (fixed via Dependabot / CI scanning),
         NETSDK1138    = target framework is out of support (.NET 8 ended on 10 Nov 2026). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NETSDK1138</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
