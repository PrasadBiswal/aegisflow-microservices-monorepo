<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared setup used by all 10 services: logging, error handling, health checks,
       API docs, SQL Server connection and the "migrate" command. -->
  <PropertyGroup>
    <RootNamespace>AegisFlow.ServiceDefaults</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
</Project>
